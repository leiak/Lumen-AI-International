    <name>Lumen Bootstrap</name>

    <dependencies>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-rbac</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-masterdata</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-numbering</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-wms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
            <artifactId>lumen-dispatch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lumen</groupId>
